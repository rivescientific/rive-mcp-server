{
  "name": "rive-mcp-server",
  "version": "1.0.0",
  "description": "MCP server wrapping Rive + Farnsworth engines for OpenClaw agent fleet",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@rive-scientific/rive-sdk": "github:teamabundance/rive-sdk",
    "@rive/farnsworth-core": "github:abundancere/farnsworth-core",
    "@supabase/supabase-js": "^2.49.1",
    "express": "^4.21.2",
    "zod": "^3.24.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "node-cron": "^3.0.3",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
